<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.brainrot.legacy" android:versionCode="4" android:versionName="1.3">
    <!-- Target API 4 opts out of implicit phone/storage permissions on later OSes.
         The API 3 minimum and Java API boundary are unchanged. -->
    <uses-sdk android:minSdkVersion="3" android:targetSdkVersion="4" />
    <!-- Later Android versions must not scale this as a fixed legacy-size screen.
         These declarations do not raise minSdkVersion or add newer Java APIs. -->
    <supports-screens android:smallScreens="true" android:normalScreens="true"
        android:largeScreens="true" android:xlargeScreens="true"
        android:anyDensity="true" android:resizeable="true" />
    <!-- No Internet, storage, native library, or CPU-feature requirements. -->
    <application android:label="Brainrot 10M" android:theme="@style/AppTheme">
        <activity android:name=".ChatActivity" android:label="Brainrot 10M"
            android:configChanges="keyboardHidden|orientation|screenSize" android:exported="true"
            android:resizeableActivity="true" android:maxAspectRatio="0.0"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
